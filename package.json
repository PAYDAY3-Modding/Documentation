{
  "name": "payday3-modding-docs",
  "private": true,
  "version": "0.1.0",
  "description": "Community documentation for PAYDAY 3 modding with the custom UE5 modkit, CrimeFactory, and PDML.",
  "scripts": {
    "build": "antora antora-playbook.yml && node scripts/build-search.js",
    "dev": "node scripts/dev.js",
    "build:fetch": "antora --fetch antora-playbook.yml",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "antora": "3.2.0"
  }
}
